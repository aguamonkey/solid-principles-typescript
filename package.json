{
  "name": "solid-principles-typescript",
  "version": "1.0.0",
  "description": "Educational repository demonstrating SOLID principles with TypeScript and React",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext ts,tsx --max-warnings 0",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "check": "npm run type-check && npm run lint && npm run test:docs && npm test && npm run build",
    "test:docs": "node --test tests/tooling/*.test.mjs && node scripts/check-docs.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.2.2",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "solid",
    "typescript",
    "react",
    "design-patterns",
    "clean-code",
    "education"
  ],
  "author": "aguamonkey",
  "license": "MIT",
  "homepage": "https://aguamonkey.github.io/solid-principles-typescript",
  "engines": {
    "node": ">=22.12.0"
  }
}
